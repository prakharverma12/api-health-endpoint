POLL_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=5
MAX_RETRIES=4
BACKOFF_BASE_SECONDS=1

# Latency drift detection (z-score based anomaly detection, holistic all-time baseline)
DRIFT_MIN_SAMPLES=5
DRIFT_ZSCORE_THRESHOLD=4.0

# Latency trend detection (slope-based, catches sustained drift that the z-score check absorbs)
TREND_WINDOW=10
TREND_MIN_SAMPLES=6
TREND_SLOPE_THRESHOLD_MS=5.0

# Phase 3 only
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
